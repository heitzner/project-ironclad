PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LOCAL_DEVELOPMENT_ORIGINS=true
JWT_SECRET=replace-this-development-secret-before-deployment
JWT_TTL_SECONDS=28800
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Project IronClad

# Data store: "memory" (default, data resets on restart) or "postgres" (Supabase)
DATA_STORE=memory
# Supabase Session pooler connection string (port 5432), without ?sslmode
DATABASE_URL=
# Path to the Supabase CA certificate (Dashboard > Database Settings > SSL Configuration)
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
